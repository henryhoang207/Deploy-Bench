<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- STORAGE.
         BatchActivity reads /sdcard/deploybench/{config.json,in,models} and
         writes /sdcard/deploybench/out. Those files are placed by `adb push`,
         i.e. by the shell user, NOT by this app -- so app-specific storage is
         not an option without changing the device path in run_cell.sh,
         soak.sh and BatchActivity.kt together.

         On API 30+ that directory is only reachable with All-Files access.
         The permission is grantable from the host with no on-device tapping:
             adb shell appops set --uid org.deploybench.app MANAGE_EXTERNAL_STORAGE allow
         which keeps the campaign scriptable. See android/README.md.

         NOTE: android:requestLegacyExternalStorage is deliberately ABSENT. It is
         ignored for apps targeting API 30+, so at targetSdk 34 it would be dead
         config that reads as if it were doing something. All-Files access is the
         only mechanism actually in play here. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- NO android.permission.WAKE_LOCK: nothing in the app acquires a WakeLock.
         Screen-on during a cell is enforced from the HOST
         (`adb shell svc power stayon usb`) -- see android/README.md. An unused
         permission in an artifact that reviewers may inspect is a claim the code
         does not back up. -->

    <!-- arm64 CPU inference only: no camera, mic, or network is ever used.
         Declared absent so the measurement surface is auditable from the APK. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="DeployBench"
        android:supportsRtl="false"
        android:hardwareAccelerated="false"
        android:largeHeap="true"
        android:theme="@android:style/Theme.NoTitleBar">

        <!-- exported=true is REQUIRED: run_cell.sh starts this from the shell with
             `am start -n org.deploybench.app/.BatchActivity`, which is blocked for
             non-exported components on Android 12+.

             launchMode=singleTask is a DELIBERATE trade with a script-side
             obligation. It prevents two concurrent batches from ever running in
             one process, but it also means `am start` against a LIVE instance
             delivers onNewIntent and does NOT re-enter onCreate -- where all the
             work is. run_cell.sh MUST therefore
                 adb shell am force-stop org.deploybench.app
             immediately before `am start`, or a cell can silently not run.

             There is no android:keepScreenOn here: keepScreenOn is a View
             attribute and is not part of the <activity> manifest schema. -->
        <activity
            android:name=".BatchActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
